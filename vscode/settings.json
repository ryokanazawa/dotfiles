{
    "window.zoomLevel": 0.3,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "files.insertFinalNewline": true,
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "Inconsolata-dz for Powerline",
    "[python]": {
        "editor.formatOnSave": true
    },
    "diffEditor.renderSideBySide": false,
    "lldb.library": "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.expressions": "native",
    "git.autofetch": true,
    "debug.disassemblyView.showSourceCode": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "explorer.confirmDelete": false,
    "[markdown]": {
        "editor.lineHeight": 24,
        "editor.renderLineHighlight": "none",
        "editor.lineNumbers": "on",
        "editor.occurrencesHighlight": "off"
    },
    "window.commandCenter": false,
    "workbench.navigationControl.enabled": false,
    "editor.scrollBeyondLastLine": false,
    "explorer.confirmDragAndDrop": false,
    "lldb.suppressUpdateNotifications": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "terminal.integrated.env.osx": {
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "NO_COLOR": null
    },
    "editor.fontSize": 13,
    "workbench.colorTheme": "Gruvbox Dark Medium",
    "editor.defaultFormatter": "vscode.markdown-language-features",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.panel.showLabels": false,
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.preferredLocation": "sidebar",
    "chat.agent.enabled": false,
    "chat.checkpoints.enabled": false,
    "chat.editRequests": "none",
    "workbench.editor.tabSizing": "fixed",
    "git.confirmSync": false,
    "git.replaceTagsWhenPull": true,
    "editor.minimap.enabled": false,
    "workbench.activityBar.location": "top",
    "claudeCode.enableNewConversationShortcut": true,
    "editor.fontFamily": "'Guguru Sans Code 35', Menlo, Monaco, 'Courier New', monospace",
    "workbench.experimental.modernUI": true,
    "update.showReleaseNotes": false,
    "security.workspace.trust.untrustedFiles": "open",
    "qwen-code.provider": "api-key"
}
