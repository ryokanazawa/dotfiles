prefix_rule(
    pattern = [
        "env",
        "DEVELOPER_DIR=/Applications/Xcode_26.5.app/Contents/Developer",
        "xcodebuild",
    ],
    decision = "allow",
    justification = "Xcode 26.5を指定したxcodebuildを常時許可",
)
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
