[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[user]
	name = Ryo Kanazawa
	email = ryoau9@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBqZzvHC3k2XmHNeKrbfiw5ZUAQCf2FbOtispQ2theGB
[color]
	ui = auto
[alias]
	logg = log --graph --pretty='format:%C(yellow)%h%Cblue%d%Creset %s %C(white dim)%an, %ar%Creset'
	s = status --short --branch
	co = checkout
	difff = diff --word-diff
	fo = fetch origin
[core]
	precomposeunicode = true
	editor = subl -w
	quotepath = false
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
